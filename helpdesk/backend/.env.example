# ============================================
# EXEMPLO DE VARIÁVEIS DE AMBIENTE
# ============================================
# Copie este arquivo para ".env" e ajuste os valores:
#     cp .env.example .env
#
# O pydantic-settings lê o .env automaticamente (ver app/config.py), e os
# valores aqui SOBRESCREVEM os padrões definidos no código.

# Chave usada para assinar os tokens JWT.
# Gere um valor aleatório, nunca use o padrão em produção.
# Para gerar: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria

# Algoritmo de assinatura do JWT (HS256 = HMAC + SHA256).
ALGORITHM=HS256

# Validade do token de acesso, em minutos.
# Passou disso, o usuário precisa fazer login de novo.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# URL de conexão com o banco.
#   PostgreSQL (produção):
DATABASE_URL=postgresql+psycopg2://usuario:senha@localhost:5432/helpdesk
#   SQLite (desenvolvimento, sem instalar nada):
# DATABASE_URL=sqlite:///./helpdesk.db

# Validade do token de "esqueci minha senha", em minutos.
# O padrão do código é 120 (2 horas).
PASSWORD_RESET_EXPIRE_MINUTES=120

# Tamanho mínimo aceito para senha, no cadastro e na redefinição.
SENHA_MINIMO_CARACTERES=6

# Endereço do frontend. É usado para montar o link de redefinição que
# seria enviado por e-mail ("{FRONTEND_URL}/redefinir-senha?token=...").
FRONTEND_URL=http://localhost:5173

VITE_API_URL=http://127.0.0.1:8000

# ============================================
# INTELIGÊNCIA ARTIFICIAL (compatível com OpenAI)
# ============================================
# Chave do provedor. NUNCA use prefixo VITE_ aqui: o valor iria para o
# navegador. Sem chave, o backend usa os fallbacks (regras + base de
# conhecimento local) e o sistema continua funcionando.
AI_ENABLED=True
AI_API_KEY=troque-pela-chave-do-provedor

# Endereço compatível com a API da OpenAI.
#   Groq:   https://api.groq.com/openai/v1
#   OpenAI: https://api.openai.com/v1
#   Ollama: http://127.0.0.1:11434/v1
AI_BASE_URL=https://api.groq.com/openai/v1

AI_MODEL_PRIORIDADE=llama-3.1-8b-instant
AI_MODEL_CHAT=llama-3.3-70b-versatile
AI_TIMEOUT_SECONDS=8
AI_MAX_TOKENS_PRIORIDADE=200
AI_MAX_TOKENS_CHAT=800
AI_TEMPERATURE=0.1
AI_CHAT_MAX_HISTORICO=10
AI_CHAT_MAX_CARACTERES=2000
AI_CHAT_MAX_POR_HORA=30